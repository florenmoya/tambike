# Supabase Postgres
# Public Supabase project config for browser-safe client features.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<publishable-key>"

# Optional server-only Supabase API credentials for future Supabase client features.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_<secret-key>"

# Runtime should use the Supabase transaction pooler / pooled connection string.
DATABASE_URL="postgresql://postgres.<project-ref>:<database-password>@<aws-region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Prisma migrations and seed should use the direct database connection string.
DIRECT_URL="postgresql://postgres:<database-password>@db.<project-ref>.supabase.co:5432/postgres"
# Optional: set when Prisma needs a separate shadow database for migration diffing.
SHADOW_DATABASE_URL=""

SESSION_SECRET="replace-with-32-byte-random-secret"
CRON_SECRET="replace-with-cron-secret"

# Private member media. Vercel supplies temporary AWS credentials through OIDC.
AWS_REGION="ap-southeast-1"
AWS_ROLE_ARN="arn:aws:iam::<account-id>:role/<vercel-member-media-role>"
S3_BUCKET_NAME="<private-member-media-bucket>"
