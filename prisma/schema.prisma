generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  rider
  organizer
  admin
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS_ONLY
  PRIVATE
}

enum RosterIdentity {
  VISIBLE
  ANONYMOUS
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizerVerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PENDING_ADMIN_REVIEW
  PUBLISHED
  ONGOING
  COMPLETED
  NEEDS_CHANGES
  REJECTED
  CANCELLED
}

enum EventType {
  TAMBIKE        @map("Tambike")
  BIKE_NIGHT     @map("Bike Night")
  COFFEE_RIDE    @map("Coffee Ride")
  CLUB_EB        @map("Club EB")
  BRAND_EVENT    @map("Brand Event")
  TEST_RIDE      @map("Test Ride")
  CHARITY_RIDE   @map("Charity Ride")
  TRACK_DAY      @map("Track Day")
  ENDURANCE_RIDE @map("Endurance Ride")
  MOTO_EXPO      @map("Moto Expo")
  RACE           @map("Race")
}

enum EventRecurrence {
  NONE
  WEEKLY
}

enum AttendanceType {
  direct
  ride_out @map("ride-out")
  club
}

enum RsvpStatus {
  interested
  going
  waitlist
  cancelled
}

enum PassStatus {
  active
  checked_in
  cancelled
}

enum CheckInMethod {
  qr
  manual
  staff_camera
  staff_upload
  staff_manual
  rider_qr
}

enum CheckInStatus {
  pending
  confirmed
}

enum SelfCheckInMode {
  staff_only
  self_review
  self_instant
}

enum SelfCheckInState {
  closed
  open
  paused
}

enum OrganizerQrMode {
  rotating
  fixed
}

enum ApprovalDecision {
  pending
  approved
  approved_with_conditions
  rejected
  needs_changes
  published
}

enum PerkRedemptionStatus {
  available
  redeemed
  cancelled
}

enum FlagStatus {
  open
  resolved
  dismissed
  escalated
}

enum GiveawayKind {
  raffle
  giveaway
}

enum GiveawayStatus {
  draft
  scheduled
  open
  paused
  locked
  drawing
  claims_open
  completed
  cancelled
  suspended
}

enum GiveawayComplianceStatus {
  draft
  pending_review
  approved
  changes_requested
  rejected
}

enum GiveawayEntryMode {
  automatic
  opt_in
  claim_code
  manual_only
}

enum GiveawayEntryPath {
  automatic
  opt_in
  campaign_code
  manual
}

enum GiveawayVisibility {
  event_page
  registered_riders
  eligible_riders
  hidden
}

enum GiveawayEligibilitySource {
  active_rsvp_pass
  confirmed_check_in
  staff_confirmed_check_in
  perk_redemption
  campaign_code
  manual
}

enum GiveawayEntryStatus {
  eligible
  locked
  disqualified
  withdrawn
}

enum GiveawayEntryEventType {
  automatic_qualified
  opted_in
  campaign_code_claimed
  manual_grant
  manual_revoke
  source_revalidated
}

enum GiveawayPresentationLabelKind {
  consented_name
  masked
}

enum GiveawayAwardMode {
  random_draw
  first_come
  guaranteed
  manual_selection
}

enum GiveawayPrizeDisclosure {
  revealed
  surprise
}

enum GiveawayPrizeItemStatus {
  available
  reserved
  fulfilled
  voided
}

enum GiveawayDrawType {
  initial
  redraw
}

enum GiveawayDrawStatus {
  pending
  completed
  published
  voided
}

enum GiveawayAwardStatus {
  pending_verification
  claimable
  verified
  fulfilled
  declined
  disqualified
  expired
  voided
  superseded
}

enum GiveawayClaimVerificationMethod {
  camera
  upload
  manual
}

enum GiveawayClaimVerificationResult {
  verified
  rejected
}

enum GiveawayFulfillmentType {
  onsite
  digital_code
  delivery
  manual_contact
}

enum GiveawayFulfillmentStatus {
  pending
  fulfilled
  failed
  cancelled
}

model User {
  id                   String             @id @default(cuid())
  displayName          String
  email                String             @unique
  passwordHash         String
  role                 Role               @default(rider)
  verificationStatus   VerificationStatus @default(UNVERIFIED)
  accountStatus        AccountStatus      @default(ACTIVE)
  suspendedAt          DateTime?
  suspendedByUserId    String?
  suspensionReason     String?            @db.VarChar(500)
  area                 String
  bikeModel            String?
  clubName             String?
  profileSlug          String?            @unique
  profileBio           String?
  profileVisibility    ProfileVisibility  @default(PRIVATE)
  defaultRosterIdentity RosterIdentity    @default(ANONYMOUS)
  profilePhotoMediaId  String?            @unique
  profilePhotoStorageKey String?
  profilePhotoMimeType String?
  profilePhotoWidth    Int?
  profilePhotoHeight   Int?
  profilePhotoFinalizedAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  sessions                    Session[]
  suspendedBy                 User?                       @relation("UserSuspendedBy", fields: [suspendedByUserId], references: [id], onDelete: SetNull)
  suspensionsPerformed        User[]                      @relation("UserSuspendedBy")
  organizerProfile            OrganizerProfile?
  motorcycle                  Motorcycle?
  rsvps                       RSVP[]
  passes                      Pass[]
  checkIns                    CheckIn[]                   @relation("CheckedInUser")
  scans                       CheckIn[]                   @relation("ScannerUser")
  perkRedemptions             PerkRedemption[]
  leads                       Lead[]
  notifications               Notification[]
  auditLogs                   AuditLog[]                  @relation("AuditActor")
  reportedFlags               FlagReport[]                @relation("FlagReporter")
  giveawaysCreated            EventGiveaway[]             @relation("GiveawayCreator")
  giveawaysAttested           EventGiveaway[]             @relation("GiveawayAttestor")
  giveawaysComplianceReviewed EventGiveaway[]             @relation("GiveawayComplianceReviewer")
  giveawaysSuspended          EventGiveaway[]             @relation("GiveawaySuspender")
  giveawayMechanicsCreated    GiveawayMechanicsVersion[]  @relation("GiveawayMechanicsCreator")
  giveawayMechanicsReviewed   GiveawayMechanicsVersion[]  @relation("GiveawayMechanicsReviewer")
  giveawayCodesCreated        GiveawayCampaignCode[]      @relation("GiveawayCampaignCodeCreator")
  giveawayCodesRevoked        GiveawayCampaignCode[]      @relation("GiveawayCampaignCodeRevoker")
  giveawayEntries             GiveawayEntry[]             @relation("GiveawayEntryRider")
  giveawayCampaignCodeClaims  GiveawayCampaignCodeClaim[] @relation("GiveawayCampaignCodeClaimRider")
  giveawayEntryEventsActed    GiveawayEntryEvent[]        @relation("GiveawayEntryEventActor")
  giveawaySnapshotsLocked     GiveawaySnapshot[]          @relation("GiveawaySnapshotLocker")
  giveawayDrawsInitiated      GiveawayDraw[]              @relation("GiveawayDrawInitiator")
  giveawayAwardsWon           GiveawayAward[]             @relation("GiveawayAwardWinner")
  giveawayClaimVerifications  GiveawayClaimVerification[] @relation("GiveawayClaimVerificationStaff")
  giveawayFulfillments        GiveawayFulfillment[]       @relation("GiveawayFulfillmentStaff")
  giveawayDeliverySubmissions GiveawayDeliveryDetail[]     @relation("GiveawayDeliverySubmitter")
  giveawayOperatorAssignments GiveawayOperator[]          @relation("GiveawayOperatorUser")
  giveawayOperatorGrants      GiveawayOperator[]          @relation("GiveawayOperatorGranter")
  giveawayOperatorRevocations GiveawayOperator[]          @relation("GiveawayOperatorRevoker")
  giveawayAuditEvents         GiveawayAuditEvent[]        @relation("GiveawayAuditActor")
  uploadedGiveawayPrizeImages GiveawayPrizeImage[]        @relation("GiveawayPrizeImageUploader")

  @@index([role, accountStatus])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OrganizerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  organizerType      String
  displayName        String
  realName           String
  contactNumber      String
  fbLink             String
  clubPageName       String?
  reason             String
  pastEventLinks     String[]
  verificationStatus OrganizerVerificationStatus @default(PENDING)
  adminNotes         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]
}

model Event {
  id                 String      @id @default(cuid())
  slug               String      @unique
  title              String
  type               EventType
  status             EventStatus @default(DRAFT)
  organizerId        String
  locationName       String      @db.VarChar(120)
  locationAddress    String      @db.VarChar(240)
  locationMapLink    String?     @db.VarChar(500)
  dateLabel          String
  timeLabel          String
  startsAt           DateTime?
  endsAt             DateTime?
  timeZone           String?     @db.VarChar(80)
  recurrence         EventRecurrence?
  recurrenceEndsAt   DateTime?
  area               String      @db.VarChar(120)
  capacity           Int?
  expectedRiders     Int
  description        String
  whatHappens        String
  poster             String
  perkPreview        String
  tags               String[]
  riskFlags          String[]
  rideOutMeetup      String?
  rideOutMapLink     String?
  rideOutCallTime    String?
  rideOutDeparture   String?
  rideOutDestination String?
  rideOutNotes       String?
  safetyRules        String[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organizer             OrganizerProfile            @relation(fields: [organizerId], references: [id])
  approvals             EventApproval[]
  rsvps                 RSVP[]
  passes                Pass[]
  checkIns              CheckIn[]
  checkInSettings       EventCheckInSettings?
  rosterSettings        EventRosterSettings?
  selfCheckInQrSessions EventSelfCheckInQrSession[]
  perks                 Perk[]
  giveaways             EventGiveaway[]
  leads                 Lead[]
  flags                 FlagReport[]

  @@index([startsAt])
}

model EventApproval {
  id         String           @id @default(cuid())
  eventId    String
  reviewerId String?
  decision   ApprovalDecision @default(pending)
  conditions String?
  notes      String?
  decidedAt  DateTime?
  createdAt  DateTime         @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model RSVP {
  id             String         @id @default(cuid())
  eventId        String
  userId         String
  status         RsvpStatus
  goingAt        DateTime?
  attendanceType AttendanceType
  companions     Int            @default(0)
  clubName       String?
  rosterIdentity RosterIdentity @default(ANONYMOUS)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pass  Pass?

  @@unique([eventId, userId])
  @@index([eventId, status, goingAt, id])
}

model Motorcycle {
  id             String   @id @default(cuid())
  userId         String   @unique
  make           String
  model          String
  year           Int?
  displacementCc Int?
  nickname       String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos MotorcyclePhoto[]
}

model MotorcyclePhoto {
  id           String   @id @default(cuid())
  motorcycleId String
  position     Int
  mediaId      String   @unique
  storageKey   String
  mimeType     String
  width        Int
  height       Int
  finalizedAt  DateTime
  createdAt    DateTime @default(now())

  motorcycle Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)

  @@unique([motorcycleId, position])
}

model MemberMediaCleanupIntent {
  id             String   @id @default(cuid())
  userId         String
  storageKey     String   @unique
  cleanupAfter   DateTime
  claimToken     String?
  claimExpiresAt DateTime?
  attemptCount   Int      @default(0)
  lastAttemptAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([cleanupAfter, createdAt, id])
  @@index([claimExpiresAt])
}

model EventRosterSettings {
  eventId   String   @id
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Pass {
  id          String     @id @default(cuid())
  eventId     String
  userId      String
  rsvpId      String     @unique
  qrTokenHash String     @unique
  status      PassStatus @default(active)
  generatedAt DateTime   @default(now())
  checkedInAt DateTime?

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvp     RSVP      @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  checkIns CheckIn[]
}

model CheckIn {
  id                   String         @id @default(cuid())
  eventId              String
  passId               String
  userId               String
  scannedBy            String?
  timestamp            DateTime       @default(now())
  confirmedAt          DateTime?
  status               CheckInStatus  @default(confirmed)
  method               CheckInMethod
  confirmationMethod   CheckInMethod?
  selfCheckInSessionId String?

  event              Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pass               Pass                       @relation(fields: [passId], references: [id], onDelete: Cascade)
  user               User                       @relation("CheckedInUser", fields: [userId], references: [id], onDelete: Cascade)
  scanner            User?                      @relation("ScannerUser", fields: [scannedBy], references: [id], onDelete: SetNull)
  selfCheckInSession EventSelfCheckInQrSession? @relation(fields: [selfCheckInSessionId], references: [id], onDelete: SetNull)

  @@unique([eventId, passId])
}

model EventCheckInSettings {
  eventId               String           @id
  mode                  SelfCheckInMode  @default(staff_only)
  state                 SelfCheckInState @default(closed)
  qrMode                OrganizerQrMode  @default(rotating)
  fixedQrAcknowledgedAt DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventSelfCheckInQrSession {
  id        String    @id @default(cuid())
  eventId   String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkIns CheckIn[]
}

model Perk {
  id              String  @id @default(cuid())
  eventId         String
  type            String
  description     String
  quantity        Int?
  redemptionRules String?

  event                         Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  redemptions                   PerkRedemption[]
  giveawayEligibilityConditions GiveawayEligibilityCondition[] @relation("GiveawayEligibilityPerk")
}

model PerkRedemption {
  id         String               @id @default(cuid())
  perkId     String
  userId     String
  status     PerkRedemptionStatus @default(available)
  redeemedBy String?
  redeemedAt DateTime?

  perk Perk @relation(fields: [perkId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lead {
  id                String    @id @default(cuid())
  eventId           String
  userId            String?
  name              String
  phone             String
  currentMotorcycle String
  interestedModel   String
  preferredTime     String
  consentAt         DateTime
  exportedAt        DateTime?
  createdAt         DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])
}

model FlagReport {
  id         String     @id @default(cuid())
  eventId    String?
  reporterId String?
  targetType String
  targetId   String
  reason     String
  status     FlagStatus @default(open)
  adminNotes String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  event    Event? @relation(fields: [eventId], references: [id])
  reporter User?  @relation("FlagReporter", fields: [reporterId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String    @default("general")
  title     String
  body      String
  href      String?
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])
}

model EventGiveaway {
  id                           String                   @id @default(cuid())
  eventId                      String
  creatorUserId                String
  organizerAttestedById        String?
  complianceReviewerId         String?
  suspendedByUserId            String?
  title                        String
  kind                         GiveawayKind
  status                       GiveawayStatus           @default(draft)
  complianceStatus             GiveawayComplianceStatus @default(draft)
  entryMode                    GiveawayEntryMode
  maxEntriesPerRider           Int
  presenceVerificationRequired Boolean                  @default(false)
  visibility                   GiveawayVisibility       @default(hidden)
  timeZone                     String
  entryOpensAt                 DateTime?
  entryClosesAt                DateTime?
  drawAt                       DateTime?
  claimDeadlineAt              DateTime?
  maxWinsPerRider              Int                      @default(1)
  maxWinsTotal                 Int                      @default(1)
  organizerAttestedAt          DateTime?
  complianceReviewedAt         DateTime?
  complianceReviewReason       String?
  suspendedAt                  DateTime?
  suspensionReason             String?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  event               Event                      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  creator             User                       @relation("GiveawayCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  organizerAttestedBy User?                      @relation("GiveawayAttestor", fields: [organizerAttestedById], references: [id], onDelete: Restrict)
  complianceReviewer  User?                      @relation("GiveawayComplianceReviewer", fields: [complianceReviewerId], references: [id], onDelete: Restrict)
  suspendedBy         User?                      @relation("GiveawaySuspender", fields: [suspendedByUserId], references: [id], onDelete: Restrict)
  mechanicsVersions   GiveawayMechanicsVersion[]
  eligibilityGroups   GiveawayEligibilityGroup[]
  campaignCodes       GiveawayCampaignCode[]
  entries             GiveawayEntry[]
  entryEvents         GiveawayEntryEvent[]
  snapshot            GiveawaySnapshot?
  prizePools          GiveawayPrizePool[]
  draws               GiveawayDraw[]
  awards              GiveawayAward[]
  operators           GiveawayOperator[]
  auditEvents         GiveawayAuditEvent[]

  @@index([eventId, status])
  @@index([complianceStatus, createdAt])
  @@index([status, entryOpensAt])
  @@index([status, entryClosesAt])
  @@index([status, drawAt])
  @@index([status, claimDeadlineAt])
  @@index([creatorUserId])
  @@index([organizerAttestedById])
  @@index([complianceReviewerId])
  @@index([suspendedByUserId])
}

model GiveawayMechanicsVersion {
  id                String                    @id @default(cuid())
  giveawayId        String
  version           Int
  mechanics         String
  terms             String
  sponsorDisclosure String?
  checksum          String
  createdByUserId   String
  reviewedByUserId  String?
  reviewDecision    GiveawayComplianceStatus?
  reviewReason      String?
  reviewedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  giveaway            EventGiveaway      @relation(fields: [giveawayId], references: [id], onDelete: Restrict)
  createdBy           User               @relation("GiveawayMechanicsCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedBy          User?              @relation("GiveawayMechanicsReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  acknowledgedEntries GiveawayEntry[]    @relation("GiveawayEntryAcknowledgedMechanics")
  snapshots           GiveawaySnapshot[]

  @@unique([giveawayId, version])
  @@index([createdByUserId])
  @@index([reviewedByUserId])
}

model GiveawayEligibilityGroup {
  id          String   @id @default(cuid())
  giveawayId  String
  position    Int
  label       String
  entryWeight Int
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  giveaway       EventGiveaway                       @relation(fields: [giveawayId], references: [id], onDelete: Restrict)
  conditions     GiveawayEligibilityCondition[]
  prizePoolLinks GiveawayPrizePoolEligibilityGroup[]

  @@unique([giveawayId, position])
}

model GiveawayEligibilityCondition {
  id        String                    @id @default(cuid())
  groupId   String
  source    GiveawayEligibilitySource
  perkId    String?
  config    Json
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  group GiveawayEligibilityGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  perk  Perk?                    @relation("GiveawayEligibilityPerk", fields: [perkId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([perkId])
}

model GiveawayCampaignCode {
  id               String    @id @default(cuid())
  giveawayId       String
  createdByUserId  String
  tokenHash        String    @unique
  expiresAt        DateTime
  maxUses          Int
  useCount         Int       @default(0)
  revokedAt        DateTime?
  revokedByUserId  String?
  revocationReason String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  giveaway  EventGiveaway               @relation(fields: [giveawayId], references: [id], onDelete: Restrict)
  createdBy User                        @relation("GiveawayCampaignCodeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy User?                       @relation("GiveawayCampaignCodeRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  claims    GiveawayCampaignCodeClaim[]

  @@index([giveawayId, expiresAt])
  @@index([createdByUserId])
  @@index([revokedByUserId])
}

model GiveawayEntry {
  id                             String              @id @default(cuid())
  giveawayId                     String
  riderId                        String
  status                         GiveawayEntryStatus @default(eligible)
  entryPath                      GiveawayEntryPath
  currentWeight                  Int                 @default(1)
  eligibilityCycleAt             DateTime
  qualifiedSourceFingerprint     String
  qualifiedEligibilityGroupIds   Json
  qualifiedEligibilityGroupTimings Json
  manualGrantActive              Boolean             @default(false)
  acknowledgedMechanicsVersionId String?
  acknowledgedMechanicsChecksum  String?
  acknowledgedMechanicsAt        DateTime?
  opaquePublicReference          String              @unique
  livePresentationOptedInAt      DateTime?
  livePresentationRevokedAt      DateTime?
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt

  giveaway                     EventGiveaway               @relation(fields: [giveawayId], references: [id], onDelete: Restrict)
  rider                        User                        @relation("GiveawayEntryRider", fields: [riderId], references: [id], onDelete: Restrict)
  acknowledgedMechanicsVersion GiveawayMechanicsVersion?   @relation("GiveawayEntryAcknowledgedMechanics", fields: [acknowledgedMechanicsVersionId], references: [id], onDelete: Restrict)
  events                       GiveawayEntryEvent[]
  campaignCodeClaims           GiveawayCampaignCodeClaim[]
  snapshotEntries              GiveawaySnapshotEntry[]
  awards                       GiveawayAward[]

  @@unique([giveawayId, riderId])
  @@index([giveawayId, status])
  @@index([giveawayId, status, eligibilityCycleAt, id])
  @@index([riderId])
}

model GiveawayCampaignCodeClaim {
  id             String   @id @default(cuid())
  campaignCodeId String
  riderId        String
  entryId        String
  idempotencyKey String
  createdAt      DateTime @default(now())

  campaignCode GiveawayCampaignCode @relation(fields: [campaignCodeId], references: [id], onDelete: Restrict)
  rider        User                 @relation("GiveawayCampaignCodeClaimRider", fields: [riderId], references: [id], onDelete: Restrict)
  entry        GiveawayEntry        @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@unique([campaignCodeId, riderId])
  @@unique([campaignCodeId, idempotencyKey])
  @@index([riderId])
  @@index([entryId])
}

model GiveawayEntryEvent {
  id             String                 @id @default(cuid())
  giveawayId     String
  entryId        String
  type           GiveawayEntryEventType
  sourceKey      String
  sourceSnapshot Json?
  weightDelta    Int
  actorUserId    String?
  idempotencyKey String
  createdAt      DateTime               @default(now())

  giveaway EventGiveaway @relation(fields: [giveawayId], references: [id], onDelete: Restrict)
  entry    GiveawayEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  actor    User?         @relation("GiveawayEntryEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([giveawayId, idempotencyKey])
  @@index([entryId])
  @@index([actorUserId])
  @@index([giveawayId, createdAt])
}

model GiveawaySnapshot {
  id                      String    @id @default(cuid())
  giveawayId              String    @unique
  mechanicsVersionId      String
  configDigest            String
  snapshotDigest          String
  candidateCount          Int
  seedCommitment          String
  encryptedSeedCiphertext String
  encryptedSeedIv         String
  encryptedSeedAuthTag    String
  encryptionKeyVersion    String
  algorithmVersion        String
  lockedByUserId          String
  lockedAt                DateTime  @default(now())
  seedRevealedAt          DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  giveaway         EventGiveaway            @relation(fields: [giveawayId], references: [id], onDelete: Restrict)
  mechanicsVersion GiveawayMechanicsVersion @relation(fields: [mechanicsVersionId], references: [id], onDelete: Restrict)
  lockedBy         User                     @relation("GiveawaySnapshotLocker", fields: [lockedByUserId], references: [id], onDelete: Restrict)
  entries          GiveawaySnapshotEntry[]
  draws            GiveawayDraw[]

  @@index([mechanicsVersionId])
  @@index([lockedByUserId])
}

model GiveawaySnapshotEntry {
  id                           String   @id @default(cuid())
  snapshotId                   String
  entryId                      String
  opaquePublicReference        String
  frozenWeight                 Int
  eligibilityCycleAt           DateTime
  qualifiedSourceFingerprint   String
  qualifiedEligibilityGroupIds Json
  qualifiedEligibilityGroupTimings Json
  rankSourceDigest             String
  presentationLabel           String?
  presentationLabelKind       GiveawayPresentationLabelKind?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  snapshot GiveawaySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  entry    GiveawayEntry    @relation(fields: [entryId], references: [id], onDelete: Restrict)
  awards   GiveawayAward[]

  @@unique([snapshotId, entryId])
  @@index([entryId])
}

model GiveawayPrizePool {
  id                           String                  @id @default(cuid())
  giveawayId                   String
  position                     Int
  title                        String
  description                  String?
  publicDisclosure             GiveawayPrizeDisclosure @default(revealed)
  publicTitle                  String?
  publicDescription            String?
  awardMode                    GiveawayAwardMode
  fulfillmentType              GiveawayFulfillmentType
  inventoryLimit               Int?
  maxWinsPerRider              Int                     @default(1)
  presenceVerificationRequired Boolean                 @default(false)
  claimDeadlineAt              DateTime?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  giveaway          EventGiveaway                       @relation(fields: [giveawayId], references: [id], onDelete: Restrict)
  publicImage       GiveawayPrizeImage?
  prizeItems        GiveawayPrizeItem[]
  eligibilityGroups GiveawayPrizePoolEligibilityGroup[]
  awards            GiveawayAward[]

  @@unique([giveawayId, position])
  @@index([giveawayId, awardMode])
}

model GiveawayPrizeImage {
  id               String   @id @default(cuid())
  prizePoolId      String   @unique
  uploadedByUserId String
  mediaId          String   @unique
  storageKey       String   @unique
  mimeType         String
  width            Int
  height           Int
  finalizedAt      DateTime
  createdAt        DateTime @default(now())

  prizePool  GiveawayPrizePool @relation(fields: [prizePoolId], references: [id], onDelete: Restrict)
  uploadedBy User              @relation("GiveawayPrizeImageUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([uploadedByUserId])
}

model GiveawayPrizeItem {
  id                      String                  @id @default(cuid())
  prizePoolId             String
  position                Int
  title                   String
  description             String?
  status                  GiveawayPrizeItemStatus @default(available)
  digitalSecretCiphertext String?
  digitalSecretIv         String?
  digitalSecretAuthTag    String?
  encryptionKeyVersion    String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  prizePool GiveawayPrizePool @relation(fields: [prizePoolId], references: [id], onDelete: Restrict)
  awards    GiveawayAward[]

  @@unique([prizePoolId, position])
  @@index([prizePoolId, status])
}

model GiveawayPrizePoolEligibilityGroup {
  id                 String   @id @default(cuid())
  prizePoolId        String
  eligibilityGroupId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  prizePool        GiveawayPrizePool        @relation(fields: [prizePoolId], references: [id], onDelete: Restrict)
  eligibilityGroup GiveawayEligibilityGroup @relation(fields: [eligibilityGroupId], references: [id], onDelete: Restrict)

  @@unique([prizePoolId, eligibilityGroupId])
  @@index([eligibilityGroupId])
}

model GiveawayDraw {
  id                String             @id @default(cuid())
  giveawayId        String
  snapshotId        String
  sequence          Int
  type              GiveawayDrawType
  status            GiveawayDrawStatus @default(pending)
  idempotencyKey    String
  algorithmVersion  String
  inputDigest       String
  resultDigest      String?
  initiatedByUserId String
  reasonDigest      String?
  completedAt       DateTime?
  publishedAt       DateTime?
  voidedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  giveaway    EventGiveaway    @relation(fields: [giveawayId], references: [id], onDelete: Restrict)
  snapshot    GiveawaySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  initiatedBy User             @relation("GiveawayDrawInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  awards      GiveawayAward[]

  @@unique([giveawayId, sequence])
  @@unique([giveawayId, idempotencyKey])
  @@index([giveawayId, status])
  @@index([snapshotId])
  @@index([initiatedByUserId])
}

model GiveawayAward {
  id                   String              @id @default(cuid())
  giveawayId           String
  entryId              String
  drawId               String?
  prizePoolId          String
  prizeItemId          String?
  snapshotEntryId      String?
  winnerUserId         String
  status               GiveawayAwardStatus @default(pending_verification)
  isCurrent            Boolean             @default(true)
  rank                 Int?
  directAllocationKey  String?             @unique
  allocationEligibilityAt DateTime?
  opaqueClaimReference String              @unique
  claimTokenHash       String?             @unique
  claimTokenIssuedAt   DateTime?
  claimTokenVersion    Int                 @default(0)
  claimDeadlineAt      DateTime?
  reasonDigest         String?
  recoveryClosedAt     DateTime?
  recoveryClosedReasonDigest String?
  recoverySourceAwardId String?            @unique
  predecessorAwardId   String?             @unique
  publicWinnerAlias    String?
  winnerAliasOptedInAt DateTime?
  winnerAliasRevokedAt DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  giveaway           EventGiveaway               @relation(fields: [giveawayId], references: [id], onDelete: Restrict)
  entry              GiveawayEntry               @relation(fields: [entryId], references: [id], onDelete: Restrict)
  draw               GiveawayDraw?               @relation(fields: [drawId], references: [id], onDelete: Restrict)
  prizePool          GiveawayPrizePool           @relation(fields: [prizePoolId], references: [id], onDelete: Restrict)
  prizeItem          GiveawayPrizeItem?          @relation(fields: [prizeItemId], references: [id], onDelete: Restrict)
  snapshotEntry      GiveawaySnapshotEntry?      @relation(fields: [snapshotEntryId], references: [id], onDelete: Restrict)
  winner             User                        @relation("GiveawayAwardWinner", fields: [winnerUserId], references: [id], onDelete: Restrict)
  recoverySource     GiveawayAward?              @relation("GiveawayAwardRecovery", fields: [recoverySourceAwardId], references: [id], onDelete: Restrict)
  recoverySuccessor  GiveawayAward?              @relation("GiveawayAwardRecovery")
  predecessor        GiveawayAward?              @relation("GiveawayAwardPredecessor", fields: [predecessorAwardId], references: [id], onDelete: Restrict)
  redrawSuccessor    GiveawayAward?              @relation("GiveawayAwardPredecessor")
  claimVerifications GiveawayClaimVerification[]
  fulfillments       GiveawayFulfillment[]
  deliveryDetail     GiveawayDeliveryDetail?

  @@index([giveawayId, status])
  @@index([entryId])
  @@index([drawId])
  @@index([prizePoolId])
  @@index([prizeItemId])
  @@index([snapshotEntryId])
  @@index([winnerUserId])
  @@index([recoveryClosedAt])
}

model GiveawayClaimVerification {
  id                  String                          @id @default(cuid())
  awardId             String
  method              GiveawayClaimVerificationMethod
  result              GiveawayClaimVerificationResult
  operatorActorUserId String
  idempotencyKey      String
  requestDigest       String
  presenceObserved    Boolean                         @default(false)
  reasonCode          String?
  reasonDigest        String?
  createdAt           DateTime                        @default(now())

  award         GiveawayAward @relation(fields: [awardId], references: [id], onDelete: Restrict)
  operatorActor User          @relation("GiveawayClaimVerificationStaff", fields: [operatorActorUserId], references: [id], onDelete: Restrict)

  @@unique([awardId, idempotencyKey])
  @@index([awardId, createdAt])
  @@index([operatorActorUserId])
}

model GiveawayFulfillment {
  id                  String                    @id @default(cuid())
  awardId             String
  type                GiveawayFulfillmentType
  status              GiveawayFulfillmentStatus @default(fulfilled)
  operatorActorUserId String
  idempotencyKey      String
  requestDigest       String
  reference           String?
  reasonCode          String?
  reasonDigest        String?
  fulfilledAt         DateTime                  @default(now())
  createdAt           DateTime                  @default(now())

  award         GiveawayAward @relation(fields: [awardId], references: [id], onDelete: Restrict)
  operatorActor User          @relation("GiveawayFulfillmentStaff", fields: [operatorActorUserId], references: [id], onDelete: Restrict)

  @@unique([awardId, idempotencyKey])
  @@index([awardId, status])
  @@index([operatorActorUserId])
}

model GiveawayDeliveryDetail {
  id                   String   @id @default(cuid())
  awardId              String   @unique
  submittedByUserId    String
  consentVersion       String
  payloadVersion       String
  aadVersion           String
  encryptedPayload     String?
  encryptedIv          String?
  encryptedAuthTag     String?
  encryptionKeyVersion String
  winnerConsentedAt    DateTime
  retentionExpiresAt   DateTime
  purgedAt             DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  award       GiveawayAward @relation(fields: [awardId], references: [id], onDelete: Restrict)
  submittedBy User          @relation("GiveawayDeliverySubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)

  @@index([retentionExpiresAt])
  @@index([submittedByUserId])
}

model GiveawayOperator {
  id               String    @id @default(cuid())
  giveawayId       String
  userId           String
  grantedByUserId  String
  grantedAt        DateTime  @default(now())
  revokedByUserId  String?
  revokedAt        DateTime?
  revocationReasonDigest String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  giveaway  EventGiveaway @relation(fields: [giveawayId], references: [id], onDelete: Restrict)
  user      User          @relation("GiveawayOperatorUser", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User          @relation("GiveawayOperatorGranter", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedBy User?         @relation("GiveawayOperatorRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([giveawayId, userId])
  @@index([userId])
  @@index([grantedByUserId])
  @@index([revokedByUserId])
}

model GiveawayAuditEvent {
  id               String   @id @default(cuid())
  giveawayId       String
  sequence         Int
  actorUserId      String?
  action           String
  targetType       String
  targetId         String?
  canonicalPayload String
  payload          Json
  previousHash     String?
  hash             String
  createdAt        DateTime @default(now())

  giveaway EventGiveaway @relation(fields: [giveawayId], references: [id], onDelete: Restrict)
  actor    User?         @relation("GiveawayAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([giveawayId, sequence])
  @@index([actorUserId])
  @@index([giveawayId, createdAt])
}
